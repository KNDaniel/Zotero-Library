{
  "name": "zotero-library",
  "packageManager": "pnpm@12.18.0",
  "version": "0.9.8",
  "license": "MIT",
  "description": "Explora ítems, etiquetas y anotaciones de Zotero desde Obsidian y renderízalos o imprímelos con plantillas Nunjucks.",
  "repository": {
    "type": "git",
    "url": "https://github.com/KNDaniel/zotero-library.git"
  },
  "bugs": {
    "url": "https://github.com/KNDaniel/zotero-library/issues"
  },
  "homepage": "https://github.com/KNDaniel/zotero-library#readme",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "check": "pnpm run typecheck && pnpm exec vitest run",
    "release:prepare": "node scripts/release-package.mjs prepare",
    "release:verify": "node scripts/release-package.mjs verify",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/nunjucks": "^3.2.6",
    "builtin-modules": "^5.4.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "moment": "^2.31.0",
    "obsidian": "^1.14.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "nunjucks": "^3.2.4"
  }
}
